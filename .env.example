# Copy to .env and adjust. Every service reads these via st_common.config.

# Where weights, datasets, job blobs and benchmark runs live. Keep it off the
# system drive: model weights + synthetic benchmark + TensorRT engines ~ 10 GB.
ST_DATA_DIR=D:/seller-tooling

# Hugging Face cache (weights). Defaults to $ST_DATA_DIR/hf when unset.
HF_HOME=D:/seller-tooling/hf

# Redis (queue + job state). AOF persistence is enabled in infra/redis.conf.
ST_REDIS_URL=redis://localhost:6379/0

# Inference service
ST_API_HOST=0.0.0.0
ST_API_PORT=8000
# see inference/st_inference/models/registry.py
ST_MATTING_MODEL=birefnet_lite
ST_MAX_BATCH=4
ST_BATCH_WAIT_MS=40
# auto | cuda | cpu
ST_DEVICE=auto
# false => jobs wait in queue while GPU is down
ST_ALLOW_CPU_FALLBACK=false

# Telegram bot. Token is NOT committed; a human must create the bot (HUMAN_NEEDED H-004).
ST_TELEGRAM_TOKEN=
# optional: self-hosted Bot API server / test mock
ST_TELEGRAM_API_BASE=
ST_FREE_QUOTA_PER_MONTH=20
ST_RATE_LIMIT_PER_MINUTE=10
ST_INFERENCE_URL=http://localhost:8000

# Local LLM (OpenAI-compatible protocol served by llama.cpp's llama-server, running locally)
ST_LLM_BASE_URL=http://localhost:8080/v1
ST_LLM_MODEL=local

# Kaggle (remote GPU benchmarking). Put the REAL values in .env, never here.
KAGGLE_API_TOKEN=
